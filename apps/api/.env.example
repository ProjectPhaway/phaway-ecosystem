# Copiar a apps/api/.env y completar. NUNCA commitear el .env real.
# Postgres local o Neon (https://neon.tech): postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL="postgresql://phaway:phaway@localhost:5432/phaway"

PORT=3000
# development | production. En produccion activa upgrade-insecure-requests + HSTS fuerte.
NODE_ENV="development"
# Origenes permitidos por CORS, separados por coma (ej: https://phaway.pe,https://admin.phaway.pe)
WEB_ORIGIN="http://localhost:5173"
# Apagar la documentacion Swagger en produccion con SWAGGER=off
SWAGGER="on"

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiar-por-un-secreto-largo"
JWT_EXPIRES_IN="8h"

# Cloudflare R2 (Fase 1, subida de imagenes)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="phaway-media"
R2_PUBLIC_URL=""

# Usuarios del panel admin (los crea pnpm db:seed). Contrasenas de 10+ caracteres.
ADMIN_EMAIL="admin@phaway.com"
ADMIN_PASSWORD=""
MARKETING_EMAIL="marketing@phaway.com"
MARKETING_PASSWORD=""

# URL publica del API (para armar las URLs de imagenes subidas en local)
PUBLIC_API_URL="http://localhost:3000"

# Resend (correos transaccionales) - https://resend.com
# En dev usa onboarding@resend.dev (sin DNS). En prod, cambia por noreply@phaway.com.pe
# cuando el dominio este verificado en Resend.
RESEND_API_KEY=""
RESEND_FROM="Phaway <onboarding@resend.dev>"
